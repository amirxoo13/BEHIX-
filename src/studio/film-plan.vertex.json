      "minItems": 0,
      "maxItems": 6
     },
     "look": {
      "type": "OBJECT",
      "description": "Optional appearance hints; maps to figure.ts Look.",
      "properties": {
       "hair": {
        "type": "STRING",
        "description": "figure.ts Hair",
        "enum": [
         "tufts",
         "short",
         "bald",
         "curly",
         "long",
         "bob",
         "ponytail",
         "scarf"
        ]
       },
       "clothing": {
        "type": "STRING",
        "description": "figure.ts CLOTHES",
        "enum": [
         "classic",
         "tshirt",
         "shirt",
         "coat",
         "dress",
         "chador"
        ]
       },
       "glasses": {
        "type": "BOOLEAN"
       },
       "beard": {
        "type": "BOOLEAN"
       },
       "mustache": {
        "type": "BOOLEAN"
       },
       "cap": {
        "type": "BOOLEAN"
       }
      },
      "required": [],
      "propertyOrdering": [
       "hair",
       "clothing",
       "glasses",
       "beard",
       "mustache",
       "cap"
