    "required": [
     "id",
     "name",
     "kind",
     "voice"
    ],
    "propertyOrdering": [
     "id",
     "name",
     "kind",
     "traits",
     "look",
     "voice",
     "rigRef"
    ]
   },
   "minItems": 1,
   "maxItems": 8
  },
  "locations": {
   "type": "ARRAY",
