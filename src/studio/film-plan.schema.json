{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://behix.app/schemas/film-plan.schema.json",
  "title": "BEHIX film plan",
  "description": "A 3-5 minute multi-scene film plan produced by Gemini on Vertex AI from a Persian story and executed deterministically by the BEHIX engine. Times are seconds. All prose fields are Persian unless noted.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "description": "Film-level settings.",
      "properties": {
        "title": {
          "type": "string",
          "description": "Persian title."
        },
        "language": {
          "type": "string",
          "description": "Spoken/caption language.",
          "enum": [
            "fa"
          ]
        },
        "targetDurationSec": {
          "type": "number",
          "description": "Target runtime; 180-300 for the 3-5 minute goal.",
          "minimum": 180,
          "maximum": 300
        },
        "style": {
          "type": "string",
          "description": "Visual style preset (proposed; today one ink stick-figure style).",
          "enum": [
            "ink",
            "flatCutout",
            "puppetRig"
          ]
        },
        "format": {
          "type": "string",
          "description": "Frame (layout.ts FORMATS).",
          "enum": [
            "portrait",
            "square",
            "landscape"
          ]
        },
        "fps": {
          "type": "integer",
          "enum": [
            30,
            60
          ],
          "description": "Export fps (project.ts settings.fps). Vertex enums are strings only; the Vertex variant sends \"30\"/\"60\"."
        },
        "logline": {
          "type": "string",
          "description": "One-sentence Persian logline."
        }
      },
      "required": [
        "title",
        "language",
        "targetDurationSec",
        "style",
        "format"
      ],
      "additionalProperties": false,
      "propertyOrdering": [
        "title",
        "language",
        "targetDurationSec",
        "style",
        "format",
        "fps",
        "logline"
      ]
    },
    "characters": {
      "type": "array",
      "description": "Cast. Engine renders up to 5 on stage per scene (story-direct MAX_ON_STAGE) and stores up to 8 (project.ts).",
      "items": {
        "$ref": "#/$defs/character"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "locations": {
      "type": "array",
      "description": "Sets used by scenes.",
      "items": {
        "$ref": "#/$defs/location"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "acts": {
      "type": "array",
      "description": "Acts in order.",
      "items": {
        "$ref": "#/$defs/act"
      },
      "minItems": 1,
      "maxItems": 5
    }
  },
  "required": [
    "meta",
    "characters",
    "locations",
    "acts"
  ],
  "propertyOrdering": [
    "meta",
    "characters",
    "locations",
    "acts"
  ],
  "$defs": {
    "character": {
      "type": "object",
      "description": "A cast member. id is referenced everywhere else.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable ASCII id, e.g. 'ali'. Unique within the plan."
        },
        "name": {
          "type": "string",
          "description": "Display name in Persian, e.g. «علی»."
        },
        "kind": {
          "type": "string",
          "description": "Body type; maps to figure.ts Kind.",
          "enum": [
            "man",
            "woman",
            "boy",
            "girl",
            "oldMan",
            "oldWoman",
            "baby"
          ]
        },
        "traits": {
          "type": "array",
          "description": "Short Persian/English acting traits (e.g. «کم‌حرف», 'restless hands'). Drive default idle and gesture choice.",
          "items": {
            "type": "string",
            "description": "trait"
          },
          "minItems": 0,
          "maxItems": 6
        },
        "look": {
          "type": "object",
          "description": "Optional appearance hints; maps to figure.ts Look.",
          "properties": {
            "hair": {
              "type": "string",
              "description": "figure.ts Hair",
              "enum": [
                "tufts",
                "short",
                "bald",
                "curly",
                "long",
                "bob",
                "ponytail",
                "scarf"
              ]
            },
            "clothing": {
              "type": "string",
              "description": "figure.ts CLOTHES",
              "enum": [
                "classic",
                "tshirt",
                "shirt",
                "coat",
                "dress",
                "chador"
              ]
            },
            "glasses": {
              "type": "boolean"
            },
            "beard": {
              "type": "boolean"
            },
            "mustache": {
              "type": "boolean"
            },
            "cap": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": false,
          "propertyOrdering": [
            "hair",
            "clothing",
            "glasses",
            "beard",
            "mustache",
            "cap"
          ]
        },
        "voice": {
          "type": "object",
          "description": "TTS casting.",
          "properties": {
            "voiceId": {
              "type": "string",
              "description": "Gemini TTS voice name from voice.ts VOICES (e.g. 'Kore', 'Charon')."
            },
            "style": {
              "type": "string",
              "description": "Short delivery note for the TTS style prompt, Persian."
            }
          },
          "required": [
            "voiceId"
          ],
          "additionalProperties": false,
          "propertyOrdering": [
            "voiceId",
            "style"
          ]
        },
        "rigRef": {
          "type": "string",
          "description": "Optional id of an AI-built puppet rig (puppet-build.server.ts). Empty/absent = built-in stick figure.",
          "nullable": true
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "voice"
      ],
      "additionalProperties": false,
      "propertyOrdering": [
        "id",
        "name",
        "kind",
        "traits",
        "look",
        "voice",
        "rigRef"
      ]
    },
    "location": {
      "type": "object",
      "description": "A set. place must be an engine renderer id.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable id, unique in plan."
        },
        "place": {
          "type": "string",
          "description": "Renderer in places.ts / places-extra.ts.",
          "enum": [
            "hospital",
            "shop",
            "elevator",
            "metro",
            "bus",
            "roof",
            "yard",
            "wedding",
            "living",
            "kitchen",
            "bedroom",
            "street",
            "park",
            "stadium",
            "car",
            "office",
            "cafe",
            "classroom",
            "blank"
          ]
        },
        "label": {
          "type": "string",
          "description": "Persian label shown in UI, e.g. «حیاط خانهٔ مادربزرگ»."
        },
        "backgroundRef": {
          "type": "string",
          "description": "Optional key of a still background generated with Imagen/Gemini image (Cloud Storage key).",
          "nullable": true
        }
      },
      "required": [
        "id",
        "place",
        "label"
      ],
      "additionalProperties": false,
      "propertyOrdering": [
        "id",
        "place",
        "label",
        "backgroundRef"
      ]
    },
    "blocking": {
      "type": "object",
      "description": "Where a character is in this shot.",
      "properties": {
        "characterId": {
          "type": "string",
          "description": "characters[].id"
        },
        "startX": {
          "type": "number",
          "description": "Horizontal position 0..1 of frame width at shot start (engine clamps edits to 0.08..0.92; off-screen uses <0 or >1 via move enter/exit).",
          "minimum": -0.2,
          "maximum": 1.2
        },
        "sit": {
          "type": "boolean",
          "description": "Seated at shot start (needs a seat in the place)."
        },
        "facing": {
          "type": "string",
          "description": "Body facing.",
          "enum": [
            "left",
            "right",
            "camera"
          ]
        },
        "hold": {
          "type": "string",
          "description": "Prop in hand at shot start (figure.ts Hold).",
          "enum": [
            "none",
            "phone",
            "cup",
            "cookie",
            "book",
            "bag",
            "ball",
            "flowers",
            "remote",
            "plate",
            "shopping",
            "umbrella",
            "laptop"
          ]
        }
      },
      "required": [
        "characterId",
        "startX"
      ],
      "additionalProperties": false,
      "propertyOrdering": [
        "characterId",
        "startX",
        "sit",
        "facing",
        "hold"
      ]
    },
    "actingBeat": {
      "type": "object",
      "description": "One timed piece of acting for one character, relative to shot start.",
      "properties": {
        "characterId": {
          "type": "string",
          "description": "characters[].id"
        },
        "atSec": {
          "type": "number",
          "description": "Start time inside the shot, seconds.",
          "minimum": 0,
          "maximum": 60
        },
        "durationSec": {
          "type": "number",
          "description": "How long the beat lasts; momentary gestures return to rest after it.",
          "minimum": 0.2,
          "maximum": 30
        },
        "gesture": {
          "type": "string",
          "description": "story-parse.ts Gesture.",
          "enum": [
            "cross",
            "hips",
            "point",
            "wave",
            "explain",
            "facepalm",
            "handsFace",
            "phoneEar",
            "handChest",
            "think",
            "shrug",
            "cheer",
            "jump",
            "kick",
            "bow",
            "drive",
            "eat",
            "write",
            "reach"
          ]
        },
        "expression": {
          "type": "string",
          "description": "face.ts Expression.",
          "enum": [
            "neutral",
            "smile",
            "laugh",
            "grin",
            "smirk",
            "angry",
            "furious",
            "pout",
            "sad",
            "cry",
            "surprised",
            "shocked",
            "worried",
            "scared",
            "content",
            "kiss",
            "sideEye",
            "annoyed",
            "embarrassed",
            "thinking",
            "sleepy"
          ]
        },
        "intensity": {
          "type": "number",
          "description": "0..1 acting intensity (proposed: scales blend speed/overshoot).",
          "minimum": 0,
          "maximum": 1
        },
        "move": {
          "type": "string",
          "description": "story-parse.ts Move.",
          "enum": [
            "enter",
            "exit",
            "approach",
            "toLeft",
            "toRight",
            "toCenter"
          ]
        },
        "targetId": {
          "type": "string",
          "description": "Character id to approach/point at/look at.",
          "nullable": true
        },
        "toX": {
          "type": "number",
          "description": "Explicit walk target 0..1 (overrides move preset).",
          "minimum": -0.2,
          "maximum": 1.2
        },
        "sit": {
          "type": "boolean",
          "description": "true = sit down, false = stand up at atSec."
        },
        "hold": {
          "type": "string",
          "description": "Pick up / put down (none) a prop.",
          "enum": [
            "none",
            "phone",
            "cup",
            "cookie",
            "book",
            "bag",
            "ball",
            "flowers",
            "remote",
            "plate",
            "shopping",
            "umbrella",
            "laptop"
          ]
        },
        "lookAt": {
          "type": "string",
          "description": "Character id to look at (proposed; today listeners auto-look at the speaker).",
          "nullable": true
        },
        "thought": {
          "type": "boolean",
          "description": "Show thought bubble (story-render Thought)."
        }
      },
      "required": [
        "characterId",
        "atSec",
        "durationSec"
      ],
      "additionalProperties": false,
      "propertyOrdering": [
        "characterId",
        "atSec",
        "durationSec",
        "gesture",
        "expression",
        "intensity",
        "move",
        "targetId",
        "toX",
        "sit",
        "hold",
        "lookAt",
        "thought"
      ]
    },
    "dialogueLine": {
      "type": "object",
      "description": "A spoken line. Times are relative to the shot start; engine re-fits to recorded TTS length.",
      "properties": {
        "speakerId": {
          "type": "string",
          "description": "characters[].id"
        },
        "text": {
          "type": "string",
          "description": "Exact Persian line as it will be spoken and captioned. Must come from (or faithfully refine) the user's script."
        },
        "startSec": {
          "type": "number",
          "description": "Start inside shot.",
          "minimum": 0,
          "maximum": 120
        },
        "endSec": {
          "type": "number",
          "description": "End inside shot; > startSec. Engine estimate: 0.45 + words/2.4 s + pause costs (story-direct.ts lineDuration).",
          "minimum": 0.3,
          "maximum": 120
        },
        "emotion": {
          "type": "string",
          "description": "Delivery emotion; also the speaker's face while talking.",
          "enum": [
            "neutral",
            "smile",
            "laugh",
            "grin",
            "smirk",
            "angry",
            "furious",
            "pout",
            "sad",
            "cry",
            "surprised",
            "shocked",
            "worried",
            "scared",
            "content",
            "kiss",
            "sideEye",
            "annoyed",
            "embarrassed",
            "thinking",
            "sleepy"
          ]
        },
        "delivery": {
          "type": "string",
          "description": "Short TTS style note in Persian (e.g. «آرام و خسته»).",
          "nullable": true
        },
        "overlapsPrevious": {
          "type": "boolean",
          "description": "Proposed: allow interruption/overlap with previous line."
        }
      },
      "required": [
        "speakerId",
        "text",
        "startSec",
        "endSec",
        "emotion"
      ],
      "additionalProperties": false,
      "propertyOrdering": [
        "speakerId",
        "text",
        "startSec",
        "endSec",
        "emotion",
        "delivery",
        "overlapsPrevious"
      ]
    },
    "audioCue": {
      "type": "object",
      "description": "Sound effect or music cue (proposed engine feature; story engine has no SFX/music today).",
      "properties": {
        "kind": {
          "type": "string",
          "description": "Cue type.",
          "enum": [
            "sfx",
            "music",
            "ambience"
          ]
        },
        "id": {
          "type": "string",
          "description": "Catalog id (e.g. labels.ts SFXS ids: clink, door, horn, shock, slap, beep, crickets, rimshot) or music cue name."
        },
        "atSec": {
          "type": "number",
          "description": "Start inside shot.",
          "minimum": 0,
          "maximum": 120
        },
        "durationSec": {
          "type": "number",
          "description": "Length; music may span shots via the 'continue' flag.",
          "minimum": 0,
          "maximum": 300
        },
        "volume": {
          "type": "number",
          "description": "0..1",
          "minimum": 0,
          "maximum": 1
        },
        "continue": {
          "type": "boolean",
          "description": "Music keeps playing into the next shot."
        }
      },
      "required": [
        "kind",
        "id",
        "atSec"
      ],
      "additionalProperties": false,
      "propertyOrdering": [
        "kind",
        "id",
        "atSec",
        "durationSec",
        "volume",
        "continue"
      ]
    },
    "shot": {
      "type": "object",
      "description": "One camera setup. The engine renders shots back to back inside the scene.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique id, e.g. 'a1s2sh3'."
        },
        "shotType": {
          "type": "string",
          "description": "Framing. wide/medium/close exist today (story-direct SHOT_ZOOM); others proposed.",
          "enum": [
            "establishing",
            "wide",
            "full",
            "medium",
            "mediumClose",
            "close",
            "extremeClose",
            "overShoulder",
            "twoShot",
            "insert",
            "reaction"
          ]
        },
        "cameraMove": {
          "type": "string",
          "description": "Camera motion over the shot. Engine today only interpolates zoom/cx/cy (story-render cameraAt).",
          "enum": [
            "static",
            "pushIn",
            "pullOut",
            "panLeft",
            "panRight",
            "truck",
            "follow",
            "shake",
            "rackFocus"
          ]
        },
        "subjectId": {
          "type": "string",
          "description": "Character the camera frames/follows (null = scene center).",
          "nullable": true
        },
        "lens": {
          "type": "string",
          "description": "Proposed perspective hint; maps to zoom range.",
          "enum": [
            "wide",
            "normal",
            "tele"
          ]
        },
        "durationSec": {
          "type": "number",
          "description": "Shot length, seconds.",
          "minimum": 0.8,
          "maximum": 40
        },
        "characters": {
          "type": "array",
          "description": "Blocking of everyone visible in this shot.",
          "items": {
            "$ref": "#/$defs/blocking"
          },
          "minItems": 0,
          "maxItems": 5
        },
        "acting": {
          "type": "array",
          "description": "Timed acting beats.",
          "items": {
            "$ref": "#/$defs/actingBeat"
          },
          "minItems": 0,
          "maxItems": 40
        },
        "dialogue": {
          "type": "array",
          "description": "Spoken lines in this shot, in order.",
          "items": {
            "$ref": "#/$defs/dialogueLine"
          },
          "minItems": 0,
          "maxItems": 12
        },
        "caption": {
          "type": "string",
          "description": "Optional on-screen narration (راوی).",
          "nullable": true
        },
        "audio": {
          "type": "array",
          "description": "SFX/music cues.",
          "items": {
            "$ref": "#/$defs/audioCue"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "transitionOut": {
          "type": "string",
          "description": "How this shot ends into the next.",
          "enum": [
            "cut",
            "fade",
            "dipToBlack",
            "crossDissolve",
            "wipe",
            "matchCut"
          ]
        },
        "sourceLines": {
          "type": "array",
          "description": "1-based line numbers of the user's script this shot covers (traceability, like story-parse SourceSpan).",
          "items": {
            "type": "integer",
            "description": "line",
            "minimum": 1
          },
          "minItems": 0,
          "maxItems": 40
        }
      },
      "required": [
        "id",
        "shotType",
        "cameraMove",
        "durationSec",
        "characters",
        "acting",
        "dialogue",
        "transitionOut"
      ],
      "additionalProperties": false,
      "propertyOrdering": [
        "id",
        "shotType",
        "cameraMove",
        "subjectId",
        "lens",
        "durationSec",
        "characters",
        "acting",
        "dialogue",
        "caption",
        "audio",
        "transitionOut",
        "sourceLines"
      ]
    },
    "scene": {
      "type": "object",
      "description": "A continuous action in one location and time.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique id."
        },
        "locationId": {
          "type": "string",
          "description": "locations[].id"
        },
        "timeOfDay": {
          "type": "string",
          "description": "Maps to SceneTimeline.night (night/dusk → night=true today).",
          "enum": [
            "dawn",
            "morning",
            "noon",
            "afternoon",
            "dusk",
            "night"
          ]
        },
        "mood": {
          "type": "string",
          "description": "Scene tone; proposed driver for lighting palette, pacing and music.",
          "enum": [
            "calm",
            "tense",
            "comic",
            "sad",
            "romantic",
            "mysterious",
            "joyful",
            "angry"
          ]
        },
        "summary": {
          "type": "string",
          "description": "One or two Persian sentences: what happens and why it matters."
        },
        "sourceLines": {
          "type": "array",
          "description": "1-based line numbers of the user's story this scene covers; the shot pass only sees these lines.",
          "items": {
            "type": "integer",
            "description": "line",
            "minimum": 1
          },
          "maxItems": 200
        },
        "shots": {
          "type": "array",
          "description": "Shots in order.",
          "items": {
            "$ref": "#/$defs/shot"
          },
          "minItems": 1,
          "maxItems": 40
        }
      },
      "required": [
        "id",
        "locationId",
        "timeOfDay",
        "mood",
        "summary",
        "shots"
      ],
      "additionalProperties": false,
      "propertyOrdering": [
        "id",
        "locationId",
        "timeOfDay",
        "mood",
        "summary",
        "sourceLines",
        "shots"
      ]
    },
    "act": {
      "type": "object",
      "description": "Dramatic act (setup / confrontation / resolution).",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique id."
        },
        "title": {
          "type": "string",
          "description": "Persian act title."
        },
        "purpose": {
          "type": "string",
          "description": "Story function.",
          "enum": [
            "setup",
            "confrontation",
            "climax",
            "resolution",
            "epilogue"
          ]
        },
        "scenes": {
          "type": "array",
          "description": "Scenes in order.",
          "items": {
            "$ref": "#/$defs/scene"
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "required": [
        "id",
        "title",
        "purpose",
        "scenes"
      ],
      "additionalProperties": false,
      "propertyOrdering": [
        "id",
        "title",
        "purpose",
        "scenes"
      ]
    }
  }
}